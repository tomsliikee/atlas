{
  "id": "io.github.tomsliikee.Atlas",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "atlas",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=network",
    "--socket=ssh-auth",
    "--filesystem=~/.ssh:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": [
      "--share=network"
    ],
    "env": {
      "CARGO_HOME": "/run/build/atlas/cargo",
      "CARGO_TARGET_DIR": "/run/build/atlas/target"
    }
  },
  "modules": [
    {
      "name": "atlas",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release",
        "install -Dm755 /run/build/atlas/target/release/atlas /app/bin/atlas",
        "install -Dm644 data/io.github.tomsliikee.Atlas.desktop -t /app/share/applications",
        "install -Dm644 data/io.github.tomsliikee.Atlas.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 data/io.github.tomsliikee.Atlas.gschema.xml -t /app/share/glib-2.0/schemas",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "install -Dm644 data/icons/scalable/apps/io.github.tomsliikee.Atlas.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 data/sourceview/language-specs/*.lang -t /app/share/atlas/sourceview/language-specs",
        "install -Dm644 data/sourceview/styles/*.xml -t /app/share/atlas/sourceview/styles",
        "for lang in $(cat po/LINGUAS); do install -d /app/share/locale/$lang/LC_MESSAGES && msgfmt -o /app/share/locale/$lang/LC_MESSAGES/atlas.mo po/$lang.po; done",
        "install -Dm644 insights-mono/fonts/*.ttf -t /app/share/fonts/atlas",
        "install -Dm644 insights-mono/fonts/*.txt -t /app/share/licenses/io.github.tomsliikee.Atlas/fonts",
        "install -Dm644 LICENSE -t /app/share/licenses/io.github.tomsliikee.Atlas"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            "target-sdk",
            ".flatpak-builder",
            "build-dir",
            "repo",
            ".git"
          ]
        }
      ]
    }
  ],
  "separate-locales": false
}